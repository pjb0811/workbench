{
  "name": "@jbpark/workbench",
  "version": "0.0.0",
  "private": false,
  "description": "Headless file tree + editor React library, backed by a swappable WorkbenchAdapter data source.",
  "keywords": [
    "react",
    "file-tree",
    "file-explorer",
    "code-editor",
    "headless",
    "codemirror"
  ],
  "license": "MIT",
  "author": "jbpark (https://github.com/pjb0811)",
  "homepage": "https://github.com/pjb0811/workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pjb0811/workbench.git"
  },
  "bugs": {
    "url": "https://github.com/pjb0811/workbench/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./code-editor": {
      "types": "./dist/code-editor.d.ts",
      "import": "./dist/code-editor.js",
      "require": "./dist/code-editor.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0+sha512.66c1ac4c7d4762d6d7dde44c7f3e5a73591ed0a0806e751d4ed32d4f004f25b2285a906b1fd8a9e3e621df3b4e2858bf88e50e0cf626bedbe977fe434a5caf85",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "check-types": "tsc -b",
    "check-declarations": "node scripts/check-declarations.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/merge": "^6.12.2",
    "@jbpark/ui-kit": "^10.4.0",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "codemirror": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "peerDependenciesMeta": {
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/merge": {
      "optional": true
    },
    "@jbpark/ui-kit": {
      "optional": true
    },
    "@uiw/codemirror-theme-vscode": {
      "optional": true
    },
    "@uiw/react-codemirror": {
      "optional": true
    },
    "codemirror": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/merge": "^6.12.2",
    "@eslint/js": "^10.0.1",
    "@iconify-json/vscode-icons": "^1.2.90",
    "@iconify/react": "^6.0.2",
    "@jbpark/ui-kit": "^10.4.0",
    "@microsoft/api-extractor": "^7.58.12",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.0.5",
    "codemirror": "^6.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "bash -c 'pnpm lint'",
      "prettier --write",
      "bash -c 'pnpm check-types'"
    ],
    "**/*.{js,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@jbpark/use-hooks": "^4.6.0",
    "react-arborist": "^4.0.1"
  }
}
